msgstr ""
"Yhdistä S3-yhteensopivaan talletustilajärjestelmään lisäämällä profiili"

#: kcm/ui/main.qml:30 kcm/ui/main.qml:37
#, kde-format
msgid "Add Profile…"
msgstr "Lisää profiili…"

