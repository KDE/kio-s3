msgstr "Lisäasetukset"

#. i18n("Addressing:")
#: kcm/ui/main.qml:199
#, kde-format
msgid "Use path-style S3 URLs"
msgstr "Käytä polkutyylisiä S3-verkko-osoitteita"

#: kcm/ui/main.qml:235
#, kde-format
msgid "Delete Profile"
msgstr "Poista profiili"

#: kcm/ui/main.qml:236
#, kde-format
msgid "Are you sure you want to delete the profile \"%1\"?"
msgstr "Haluatko varmasti poistaa profiilin ”%1”?"

#: s3backend.cpp:41
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Invalid S3 URI, bucket name is missing from the host.<nl/>A valid S3 URI "
"must be written in the form: <link>s3://bucket/key</link>"
msgstr ""
"Virheellinen S3-URI: konenimestä puuttuu säilön nimi.<nl/>Kelvollinen S3-URI "
"tulee kirjoittaa muodossa: <link>s3://säilö/avain</link>"

#: s3backend.cpp:162 s3backend.cpp:171
#, kde-kuit-format
msgctxt "@info"
msgid "Could not find S3 buckets, please check your AWS configuration."
msgstr "S3-säilöjä ei löytynyt: tarkista AWS-määrityksesi."

#: s3backend.cpp:647
#, kde-kuit-format
msgctxt "@info"
msgid "Cannot copy between different S3 profiles. Copy the file locally first."
msgstr ""
"Ei voida kopioida S3-profiilista toiseen. Kopioi tiedosto ensin "
"paikalliseksi."

#: s3backend.cpp:699
#, kde-kuit-format
msgctxt "@info"
msgid "Could not copy <link>%1</link> to <link>%2</link>"
msgstr "Ei voitu kopioida: <link>%1</link> → <link>%2</link>"

#: s3backend.cpp:776
#, kde-kuit-format
msgctxt "@info"
msgid "Cannot rename between different S3 profiles."
msgstr "Ei voida muutta nimiä S3-profiilien välillä."

#: s3backend.cpp:906
#, kde-format
msgctxt "@info"
msgid ""
"Some source files could not be deleted after renaming. The renamed folder "
"may still contain leftover files."
msgstr ""
"Joitakin lähdetiedostoja ei voi poistaa nimen muuttamisen jälkeen. Uuden "
"niminen kansio voi yhä sisältää jäännöstiedostoja."

#: s3backend.cpp:970 s3backend.cpp:1032
#, kde-format
msgctxt "@info"
msgid ""
"Could not retrieve the complete file listing. Some files may not be shown."
msgstr ""
"Ei voitu noutaa täyttä tiedostoluetteloa. Joitakin tiedostoja ei ehkä "
"näytetä."
