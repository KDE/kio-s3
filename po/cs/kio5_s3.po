#: s3backend.cpp:27
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Invalid S3 URI, bucket name is missing from the host.<nl/>A valid S3 URI "
"must be written in the form: <link>s3://bucket/key</link>"
msgstr ""
"Neplatná adresa S3 URI, v hostiteli chybí název úložiště.<nl/>Platná adresa "
"S3 URI musí být zapsána v následujícím formátu: <link>s3://bucket/key</link>"

#: s3backend.cpp:54
#, kde-kuit-format
msgctxt "@info"
msgid "Could not find S3 buckets, please check your AWS configuration."
msgstr "Nedařilo se najít úložiště S3, zkontrolujte prosím nastavení AWS."

#: s3backend.cpp:313
#, kde-kuit-format
msgctxt "@info"
msgid "Could not copy <link>%1</link> to <link>%2</link>"
msgstr "Nelze zkopírovat <link>%1</link> do <link>%2</link>"
