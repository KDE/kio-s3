msgstr "Opravdu chcete smazat profil \"%1\"?"

#: s3backend.cpp:41
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Invalid S3 URI, bucket name is missing from the host.<nl/>A valid S3 URI "
"must be written in the form: <link>s3://bucket/key</link>"
msgstr ""
"Neplatná adresa S3 URI, v hostiteli chybí název úložiště.<nl/>Platná adresa "
"S3 URI musí být zapsána v následujícím formátu: <link>s3://bucket/key</link>"

#: s3backend.cpp:140 s3backend.cpp:149
#, kde-kuit-format
msgctxt "@info"
msgid "Could not find S3 buckets, please check your AWS configuration."
msgstr "Nedařilo se najít úložiště S3, zkontrolujte prosím nastavení AWS."

#: s3backend.cpp:622
#, kde-kuit-format
msgctxt "@info"
msgid "Cannot copy between different S3 profiles. Copy the file locally first."
msgstr ""
"Kopírování mezi různými profily S3 není možné. Soubor nejprve zkopírujte do "
"lokálního úložiště."

#: s3backend.cpp:673
#, kde-kuit-format
msgctxt "@info"
msgid "Could not copy <link>%1</link> to <link>%2</link>"
msgstr "Nelze zkopírovat <link>%1</link> do <link>%2</link>"

#: s3backend.cpp:748
#, kde-kuit-format
msgctxt "@info"
msgid "Cannot rename between different S3 profiles."
msgstr "Nelze přejmenovat mezi různými profily S3."

#: s3backend.cpp:877
#, kde-format
msgctxt "@info"
msgid ""
"Some source files could not be deleted after renaming. The renamed folder "
"may still contain leftover files."
msgstr ""
"Některé zdrojové soubory se po přejmenování nepodařilo odstranit. "
"Přejmenovaná složka může stále obsahovat zbytkové soubory."

#: s3backend.cpp:939 s3backend.cpp:1000
#, kde-format
msgctxt "@info"
msgid ""
"Could not retrieve the complete file listing. Some files may not be shown."
msgstr ""
"Nepodařilo se načíst úplný seznam souborů. Některé soubory se nemusí "
"zobrazit."

#~ msgid "Advanced"
#~ msgstr "Pokročilé"
